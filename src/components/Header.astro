---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="nav-actions">
			<div class="social-links">
				<a href="https://www.linkedin.com/in/paulbreuler" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Connect with Paul Breuler on LinkedIn</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
						<path
							fill="currentColor"
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						/>
					</svg>
				</a>
				<a href="https://github.com/paulbreuler" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Visit Paul Breuler's GitHub profile</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
						<path
							fill="currentColor"
							d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
						/>
					</svg>
				</a>
			</div>
			<ThemeToggle client:load />
		</div>
	</nav>
</header>
<style>
	header {
		margin: var(--margin-none);
		padding: var(--padding-header);
		background: var(--bg-header);
		box-shadow: var(--header-shadow);
	}
	h2 {
		margin: var(--margin-none);
		font-size: var(--font-size-header-title);
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	nav a {
		padding: var(--padding-nav-link);
		color: var(--black);
		border-bottom: var(--border-width-active) solid var(--border-color-transparent);
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.internal-links {
		display: flex;
		gap: 1rem;
		flex: 1;
		justify-content: center;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		color: rgb(var(--gray-dark));
		transition: var(--transition-fast);
		border-radius: var(--border-radius-md);
		border-bottom: none;
	}

	.social-links a:hover {
		color: var(--accent);
		background: rgba(var(--gray-light), var(--opacity-hover-bg));
		transform: translateY(-2px);
	}

	.social-links a:focus-visible {
		outline: var(--outline-width) solid var(--accent);
		outline-offset: var(--outline-offset);
	}

	.social-links svg {
		width: 24px;
		height: 24px;
	}

	@media (max-width: 720px) {
		nav {
			gap: 1rem;
		}

		.internal-links {
			gap: 0.5rem;
		}

		.nav-actions {
			gap: 0.75rem;
		}

		.social-links {
			gap: 0.5rem;
		}

		.social-links svg {
			width: 20px;
			height: 20px;
		}
	}
</style>

<style is:global>
	.theme-toggle {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		background: rgba(var(--gray-light), 0.1);
		border: 1px solid rgba(var(--gray), 0.2);
		border-radius: 2rem;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		font-size: 0.875rem;
		font-weight: 500;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		overflow: hidden;
	}

	.theme-toggle:hover {
		background: rgba(var(--gray-light), 0.2);
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(var(--gray), 0.15);
	}

	.theme-toggle:active {
		transform: translateY(0);
	}

	.theme-toggle:focus-visible {
		outline: var(--outline-width) solid var(--accent);
		outline-offset: var(--outline-offset);
	}

	.theme-toggle-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		position: relative;
	}

	.theme-toggle-icon svg {
		width: 20px;
		height: 20px;
		animation: iconFadeIn 0.3s ease-in-out;
	}

	.moon-icon {
		animation: iconRotateIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.sun-icon {
		animation: iconRotateIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.theme-toggle-label {
		font-family: var(--font-family-base);
		letter-spacing: 0.025em;
		user-select: none;
	}

	@keyframes iconFadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes iconRotateIn {
		from {
			opacity: 0;
			transform: rotate(-90deg) scale(0.8);
		}
		to {
			opacity: 1;
			transform: rotate(0deg) scale(1);
		}
	}

	@media (max-width: 720px) {
		.theme-toggle-label {
			display: none;
		}

		.theme-toggle {
			padding: 0.5rem;
			min-width: 2.5rem;
		}
	}
</style>
